# FlyNext environment template.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored
# (see .gitignore: `.env*`), so secrets must never be committed to the repository
# or hard-coded in source, Dockerfiles or docker-compose.yml.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# Neon example:
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/flynextdb?sslmode=require"

# Only needed when running the bundled docker-compose stack, which starts its own
# PostgreSQL service. Keep it in sync with the password inside DATABASE_URL.
POSTGRES_USER="flynextdb_owner"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="flynextdb"

# ---------------------------------------------------------------------------
# Seed scripts (optional)
# ---------------------------------------------------------------------------
# Read only by `npm run seed:reference` and its compiled twin
# `npm run seed:reference:prod`, which add cities, airports, hotels and room
# types to an existing database and attach those hotels to one hotel-owner
# account. Both are optional: leave them unset and the first run creates the
# account, prints the generated password once, and stores only its bcrypt hash
# (save it at that moment — nothing can recover it later).
#
# SEED_OWNER_EMAIL makes the account address explicit. SEED_OWNER_PASSWORD fixes
# the password: the script then never prints it, and re-running keeps the stored
# password in sync with this value.
#
# SEED_OWNER_EMAIL="hotel-owner@flynext.local"
# SEED_OWNER_PASSWORD=""

# `npm run seed` (the demo/reset fixture) ignores both variables: it clears the
# tables listed in prisma/generate_data.sql first. Never point it at a database
# that holds real data.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Use long, random values. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# jsonwebtoken duration strings: "30m", "1h", "7d".
JWT_ACCESS_TOKEN_EXPIRY_TIME="1h"
JWT_REFRESH_TOKEN_EXPIRY_TIME="7d"

# ---------------------------------------------------------------------------
# Advanced Flights System (AFS) — the flight provider
# ---------------------------------------------------------------------------
# AFS is a separate service (https://github.com/Kianoosh76/afs). There are two
# supported ways to run it. `lib/afs-client.ts` picks between them per call; see
# `lib/afs/config.ts` for the exact precedence.
#
#   A. A real AFS service — pick ONE of these two addresses.
#
#      Started from this repository's docker-compose.yml
#      (`docker compose --profile afs up -d`), from the host:
#        AFS_BASE_URL="http://localhost:4000"
#
#      The same container, reached from the `nextjs` container by its alias:
#        AFS_BASE_URL="http://afs:3000"
#
#      Any other deployment of the upstream project also works. The project
#      can be run without Docker:
#        git clone https://github.com/Kianoosh76/afs && cd afs
#        npm install && npx prisma migrate deploy && npm run dev
#
#   B. The built-in offline provider — no service and no API key required.
#      Leave `AFS_BASE_URL` empty (or set `AFS_MOCK=true`). Flight search,
#      booking, ticketing and refund compensation are then served in-process
#      from the same contract. This is what CI and Vercel use, where a local
#      container is not reachable.
#
# Only `http`/`https` URLs count, and documented placeholders such as
# `https://afs.invalid` are treated as "not configured" rather than called.
AFS_BASE_URL=""
AFS_API_KEY="replace-with-your-afs-api-key"

# Force a specific mode, overriding the URL rules above:
#   "true"  — always use the built-in offline provider.
#   "false" — always use HTTP. A missing or placeholder AFS_BASE_URL then fails
#             the call with 502 instead of silently falling back.
# Leave unset to choose by whether AFS_BASE_URL is usable.
AFS_MOCK=""

# Notes for the bundled AFS container (`docker-compose.yml` → service `afs`):
#
# - It is seeded with the upstream airport/airline dataset plus generated
#   flights for a rolling 7-day window (AFS_SEED_DAYS extends it; every restart
#   fills in the days that passed), so searches must use a future date.
# - The API key is `sha256(AFS_LOCAL_AGENCY)`. The default agency name is
#   `flynext-local`, so the matching key is:
#     node -e "console.log(require('crypto').createHash('sha256').update('flynext-local').digest('hex'))"
#   Put that value in `AFS_API_KEY` above. The container prints the same key in
#   its log line `[seed] AFS_API_KEY=…` on first start.
# - Start it with:  docker compose --profile afs up -d
#   It is behind a profile so a plain `docker compose up` is unaffected.
# - The AFS container has its own PostgreSQL service (`afs-postgres`), separate
#   from FlyNext's, because it needs its own schema.

# Agency name the bundled AFS container seeds, and the source of its API key.
AFS_LOCAL_AGENCY="flynext-local"

# Days of schedule the container seeds ahead of today.
AFS_SEED_DAYS="7"

# ---------------------------------------------------------------------------
# Cloudinary — image storage for hotel logos, room galleries and avatars
# ---------------------------------------------------------------------------
# Every uploaded image is stored here and the record keeps the absolute
# `https://res.cloudinary.com/...` URL that Cloudinary returns. This is not
# optional in production: a serverless host gives the function a read-only,
# per-invocation filesystem, so there is nowhere local to write an upload.
#
# Values come from the Cloudinary dashboard (Dashboard -> Product Environment
# Credentials). Copy the three separate values, or the single URL below:

CLOUDINARY_CLOUD_NAME="replace-with-your-cloud-name"
CLOUDINARY_API_KEY="replace-with-your-api-key"
CLOUDINARY_API_SECRET="replace-with-your-api-secret"

# Alternative single-variable form, `cloudinary://<api_key>:<api_secret>@<cloud_name>`.
# Either this or the three values above may be set; the three win when both are
# present. Never commit a real value here.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Root folder every asset is nested under. Assets land in
# `<CLOUDINARY_FOLDER>/<hotels|roomTypes|userProfiles>/<uuid>`. Defaults to
# `flynext` when unset or unusable, so leaving this blank is safe: leading,
# trailing and repeated `/` are dropped along with `.` and `..` segments, so a
# value such as `/` or `../` cannot scatter uploads across the account root.
#
# Accounts with Cloudinary's *dynamic folders* enabled are detected
# automatically (`GET /config`): the folder is then declared with the `folder`
# parameter instead of the public-ID prefix, and the public ID keeps the same
# `<CLOUDINARY_FOLDER>/<bucket>/<uuid>` shape. Nothing needs configuring for
# either mode.
CLOUDINARY_FOLDER="flynext"

# Note for `npm test`: leaving all of the above blank in `.env.test` makes the
# upload module return a mock URL instead of calling Cloudinary, so the suite
# needs no credentials and never writes to the real account.
#
# Cloudinary is the *only* supported image backend. If the credentials are
# missing outside a test run, image uploads fail with `502` rather than writing
# to a filesystem path that a serverless deployment cannot serve.
