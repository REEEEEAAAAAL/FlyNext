FROM node:24-alpine AS source
ARG AFS_REF=b3eee4edd597bfc0545ff99fbbf4e2c0c065b222
RUN apk add --no-cache git
WORKDIR /app
RUN git init . \
    && git remote add origin https://github.com/Kianoosh76/afs.git \
    && git fetch --depth 1 origin "${AFS_REF}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${AFS_REF}" \
    && rm -rf .git

FROM node:24-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=source /app/ ./
COPY afs/hardened /patch/afs/hardened
COPY afs/prepare.mjs afs/source-hashes.json /patch/afs/
RUN node /patch/afs/prepare.mjs /app
RUN npm ci && npx prisma generate
RUN npm run build && npm prune --omit=dev && npx prisma generate

FROM node:24-alpine AS runner
ARG AFS_REF=b3eee4edd597bfc0545ff99fbbf4e2c0c065b222
LABEL org.opencontainers.image.source="https://github.com/Kianoosh76/afs" \
      org.opencontainers.image.revision="${AFS_REF}"
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S -g 1001 afs && adduser -S -u 1001 -G afs afs
COPY --from=builder --chown=afs:afs /app/.next ./.next
COPY --from=builder --chown=afs:afs /app/node_modules ./node_modules
COPY --from=builder --chown=afs:afs /app/package.json ./package.json
COPY --from=builder --chown=afs:afs /app/package-lock.json ./package-lock.json
COPY --from=builder --chown=afs:afs /app/prisma ./prisma
COPY --chown=afs:afs afs ./afs
RUN sed -i 's/\r$//' afs/docker-entrypoint.sh && chmod +x afs/docker-entrypoint.sh
USER afs
EXPOSE 3000
ENTRYPOINT ["/app/afs/docker-entrypoint.sh"]
