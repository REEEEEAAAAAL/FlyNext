# Template only: npm run test:db:start generates .env.test.local with random
# credentials/identity and a NEW dedicated local PostgreSQL cluster.
# Never copy a remote DATABASE_URL or reuse .env/.env.test.
DATABASE_URL="postgresql://flynext_test:replace-with-local-random-password@127.0.0.1:55432/flynext_test?schema=public"
FLYNEXT_ALLOW_DATABASE_RESET="1"
FLYNEXT_TEST_DATABASE_ID="generated-by-test-db-start"
JWT_ACCESS_SECRET="local-test-only-random-key"
JWT_REFRESH_SECRET="different-local-test-only-random-key"
JWT_ACCESS_TOKEN_EXPIRY_TIME="1h"
JWT_REFRESH_TOKEN_EXPIRY_TIME="7d"
AFS_MOCK="true"
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
