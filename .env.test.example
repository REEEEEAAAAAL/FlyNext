# Placeholder template only. Never overwrite an existing .env.test.
# Preferred: explicitly enrolled Neon flynext_test. See docs/DEVELOPMENT.md.
DATABASE_URL="postgresql://test_role:replace-password@ep-example.us-east-2.aws.neon.tech/flynext_test?sslmode=require"
# Enrollment/consent is separate in ignored .neon-test-approval.json plus the
# actual database identity marker. This filename or an env flag is not consent.
JWT_ACCESS_SECRET="replace-with-test-only-random-secret"
JWT_REFRESH_SECRET="legacy-refresh-jwt-secret-no-longer-used-by-session-routes"
JWT_ACCESS_TOKEN_EXPIRY_TIME="1h"
JWT_REFRESH_TOKEN_EXPIRY_TIME="7d"
AFS_MOCK="true"
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional native local alternative: test:db:start generates .env.test.local;
# select it explicitly with FLYNEXT_TEST_ENV=local. Docker is not required.
