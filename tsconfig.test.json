{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		"paths": {
			"@/*": ["./*"],
			"#support/*": ["./tests/support/*"],
			"#setup/*": ["./tests/setup/*"]
		}
	},
	"include": [
		"tests/**/*.ts",
		"vitest.config.ts",
		"app/api/**/*.ts",
		"lib/**/*.ts",
		"types/**/*.ts"
	],
	"exclude": ["node_modules", "dist", ".next"]
}
