{
	"name": "flynext",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"postinstall": "prisma generate",
		"build": "next build",
		"build:server": "tsc -p tsconfig.server.json",
		"start": "next start",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"test": "vitest run --config vitest.config.ts",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"test:integration": "tsx scripts/run-integration.ts",
		"test:db:start": "tsx scripts/test-db.ts start",
		"test:db:stop": "tsx scripts/test-db.ts stop",
		"test:db:check": "tsx scripts/test-db.ts check",
		"test:db:enroll": "tsx scripts/neon-test-db.ts enroll",
		"test:db:verify": "tsx scripts/neon-test-db.ts check",
		"seed": "tsx prisma/seed.ts",
		"seed:prod": "npm run build:server && node dist/prisma/seed.js",
		"seed:reference": "tsx prisma/seed-reference.ts",
		"seed:reference:prod": "node dist/prisma/seed-reference.js",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate deploy",
		"vercel-build": "prisma generate && next build",
		"lint": "eslint .",
		"test:e2e": "tsx scripts/run-e2e.ts"
	},
	"dependencies": {
		"@prisma/client": "^6.3.1",
		"@vercel/analytics": "^2.0.1",
		"axios": "^1.6.2",
		"bcryptjs": "^3.0.2",
		"chart.js": "^4.4.8",
		"cloudinary": "^2.11.0",
		"cookie": "^1.0.2",
		"jsonwebtoken": "^9.0.2",
		"next": "15.5.28",
		"pdf-lib": "^1.17.1",
		"react": "19.0.9",
		"react-chartjs-2": "^5.3.0",
		"react-dom": "19.0.9"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.64.1",
		"@tailwindcss/postcss": "^4",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^20.19.43",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@typescript-eslint/parser": "8.71.2",
		"eslint": "9.39.5",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "5.2.0",
		"prisma": "^6.3.1",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"vitest": "^4.1.12"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"overrides": {
		"next": {
			"postcss": "8.5.23"
		}
	},
	"allowScripts": {
		"@prisma/client@6.3.1": true,
		"@prisma/engines@6.3.1": true,
		"prisma@6.3.1": true,
		"esbuild@0.28.2": true
	}
}
