{
	"name": "flynext",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"postinstall": "prisma generate",
		"build": "next build",
		"build:server": "tsc -p tsconfig.server.json",
		"start": "next start",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"seed": "tsx prisma/seed.ts",
		"seed:prod": "node dist/prisma/seed.js",
		"seed:reference": "tsx prisma/seed-reference.ts",
		"seed:reference:prod": "node dist/prisma/seed-reference.js",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate deploy",
		"vercel-build": "prisma generate && next build"
	},
	"dependencies": {
		"@prisma/client": "^6.3.1",
		"axios": "^1.6.2",
		"bcryptjs": "^3.0.2",
		"chart.js": "^4.4.8",
		"cloudinary": "^2.11.0",
		"cookie": "^1.0.2",
		"jsonwebtoken": "^9.0.2",
		"next": "15.5.27",
		"pdf-lib": "^1.17.1",
		"react": "^19.0.0",
		"react-chartjs-2": "^5.3.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"prisma": "^6.3.1",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"vitest": "^3.2.7"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	}
}
